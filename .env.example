# Quote and contact form email delivery.
# Required in production: without these the form refuses the submission and tells
# visitors to email instead, so no lead is silently lost.
# Leave blank in development to log submissions to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where form submissions are delivered
LEADS_TO=operations@corecargo.co.uk
# Public site URL used for canonical links and the sitemap (set before building for production)
NEXT_PUBLIC_SITE_URL=https://corecargo.co.uk
