# Password for /admin/leads, where every form submission is stored (required to view leads)
ADMIN_PASSWORD=
# Vercel: add the Upstash Redis integration (Storage tab > Marketplace). It sets these two
# automatically. Without them, leads are saved to ./data/leads.json (development only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Folder for leads.json when not using Redis, for a server with a persistent disk.
LEADS_DIR=
# Quote and contact form email delivery.
# Easiest email option: a free Resend account (resend.com). Until a domain is verified in Resend,
# it only delivers to the email you signed up with, so set LEADS_TO to that address for now.
RESEND_API_KEY=
# Once corecargo.co.uk is verified in Resend, set e.g. "Core Cargo <quotes@corecargo.co.uk>"
RESEND_FROM=
# Optional email copy of each lead. Leads are always saved and shown at /admin/leads.
# visitors to email instead, so no lead is silently lost.
# Leave blank in development to log submissions to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where form submissions are delivered
LEADS_TO=operations@corecargo.co.uk
# Public site URL used for canonical links and the sitemap (set before building for production)
NEXT_PUBLIC_SITE_URL=https://corecargo.co.uk
