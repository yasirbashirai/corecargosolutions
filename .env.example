# Copy these into Vercel → Project → Settings → Environment Variables (Production).
# Next.js also loads them from .env.local for local development.
# Never commit real values. .env* is gitignored except this file.

# Password for /admin/leads. Required to open the leads inbox (without it the page says
# "Set ADMIN_PASSWORD"). Generate one with: openssl rand -base64 24
ADMIN_PASSWORD=

# Persistent lead storage. Vercel's filesystem is read-only, so add Upstash Redis from the
# Vercel Marketplace (Storage → Create → Upstash Redis). It sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically. UPSTASH_REDIS_REST_URL / _TOKEN also work.
# Without Redis the form can still email a lead, but it cannot be listed at /admin/leads.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quote and contact form email delivery (Resend is the primary path).
# Until corecargo.co.uk is verified in Resend it only delivers to the signup address,
# so point LEADS_TO there while testing.
RESEND_API_KEY=
# After the domain is verified, e.g. "Core Cargo <quotes@corecargo.co.uk>"
RESEND_FROM=
# Alternative to Resend: SMTP. Leave blank to use Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where form submissions are delivered. Comma-separate several addresses.
LEADS_TO=operations@corecargo.co.uk

# Public site URL used for canonical links, Open Graph and the sitemap.
# NEXT_PUBLIC_* values are inlined at build time, so redeploy after changing this.
NEXT_PUBLIC_SITE_URL=https://corecargo.co.uk
